{
    "name": "lbcdev/map-geometries",
    "description": "Geometry classes for maps (Markers, Polylines, Polygons, etc.)",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "map",
        "geometry",
        "marker",
        "polyline",
        "polygon",
        "leaflet"
    ],
    "authors": [
        {
            "name": "LBCDev",
            "email": "luinux81@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1|^8.2|^8.3",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9|^11.0",
        "phpunit/phpunit": "^10.0|^11.0",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "LBCDev\\MapGeometries\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBCDev\\MapGeometries\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}